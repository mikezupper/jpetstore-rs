# Server-side settings for docker compose. Copy to .env on the VPS (it's
# gitignored) or export in the shell — compose reads either.

# Image coordinates — pin TAG to a deploy-NN tag for reproducible deploys;
# :latest is for people who enjoy surprises.
IMAGE=registry.livepeer.tools/jpetstore-rs
TAG=latest

# The host port the container maps to. Lesson 6 exposes it publicly to
# prove the plumbing; lesson 7 puts Caddy in front and this moves behind
# the loopback.
HOST_PORT=8081

# The pre-created external volume (docker volume create jpetstore-data)
DATA_VOLUME=jpetstore-data
